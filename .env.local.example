# Supabase — Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — Project Settings → API → service_role key (server-only,
# never exposed to the client). Only needed for app/api/payments/webhook.
# SUPABASE_SERVICE_ROLE_KEY=

# PayMongo — Dashboard → Developers → API Keys. Leave unset to use the
# simulated payment path (online checkout never redirects for real, but
# the rest of the payment/token-ledger pipeline still works end to end).
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=

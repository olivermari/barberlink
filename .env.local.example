# Supabase — Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — Project Settings → API → service_role key (server-only,
# never exposed to the client). Required: the PayMongo webhook and the
# simulated-payment path (bookings, top-ups, tips) settle payments with it.
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (GCash only, via the Payment Intent workflow) — sign up at
# dashboard.paymongo.com and complete KYC (identity verification only —
# no business docs needed) to unlock test-mode keys, free, no real
# money moves. Dashboard → Developers → API Keys for the secret key;
# Dashboard → Developers → Webhooks for the webhook signing secret
# (needs a public URL pointing at /api/payments/webhook — a Cloudflare
# quick tunnel works for local dev). Leave both unset to use the
# simulated payment path instead (online checkout never redirects for
# real, but the rest of the payment/token-ledger pipeline still works
# end to end). Local dev only — production refuses to simulate.
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=

# Vercel only — any long random string. Vercel Cron sends it as a Bearer
# token to /api/keep-alive, the daily ping that stops the free Supabase
# project from pausing.
# CRON_SECRET=

# Real Web Push (delivers to the notification bar even while the browser
# is minimized). Generate a keypair with `npx web-push generate-vapid-keys`
# — VAPID_PUBLIC_KEY/NEXT_PUBLIC_VAPID_PUBLIC_KEY are the same value,
# exposed twice because the client needs it unprefixed too.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Any long random string, matching CRON_SECRET's pattern. Supabase
# triggers (supabase/migrations/0025_push_dispatch_infra.sql) send it as
# a Bearer token to /api/push/dispatch to prove the request is really
# from this project's database — the same value must also be stored in
# Supabase Vault as the secret named 'push_dispatch_secret'
# (`npx supabase db query --linked "select vault.create_secret('<value>', 'push_dispatch_secret')"`),
# never committed anywhere.
# PUSH_DISPATCH_SECRET=
